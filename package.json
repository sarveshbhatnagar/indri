{
  "name": "indri",
  "version": "0.1.0",
  "license": "UNLICENSED",
  "bin": { "indri": "bin/indri.js" },
  "files": ["bin/", "src/", "public/", "examples/", "npm-shrinkwrap.json"],
  "publishConfig": { "access": "public" },
  "bundleDependencies": ["pm2"],
  "type": "module",
  "description": "Diagram collaboration for developers and MCP agents",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "esbuild web/app.js --bundle --format=esm --outfile=public/app.js",
    "prepack": "npm run build",
    "start": "node src/server.js",
    "dev": "npm run build && node --watch src/server.js",
    "test": "node --test test/indri.test.js test/cli.test.js",
    "test:browser": "node --test test/browser.test.js",
    "test:package": "npm run build && node --test test/package.test.js",
    "demo": "node scripts/demo.js",
    "pm2:start": "npm run build && pm2 start ecosystem.config.cjs",
    "pm2:restart": "npm run build && pm2 restart indri --update-env",
    "pm2:stop": "pm2 stop indri",
    "pm2:logs": "pm2 logs indri"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "express": "^5.3.0",
    "pm2": "^7.0.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@playwright/test": "^1.64.0",
    "esbuild": "^0.28.2"
  },
  "overrides": {
    "basic-ftp": "^6.2.3",
    "js-yaml": "^4.3.2",
    "chokidar": "^4.0.3"
  }
}
